
using System;
using System.Collections.Generic;
using System.IO;
using Microsoft.Xna.Framework;
using Microsoft.Xna.Framework.Graphics;
using Microsoft.Xna.Framework.Input;

namespace Juego
{
    public class Game1 : Game
    {
        private readonly GraphicsDeviceManager _graphics;
        private SpriteBatch _spriteBatch = null!;
        private Texture2D _pixel = null!;
        private Jugador _jugador = null!;
        private GestorRondas _rondas = null!;
        private Jefe? _jefe;
        private JefeArdilla? _ardilla;

        private static readonly Rectangle PlataformaJefe =
            new Rectangle(380, 258, 200, 14);

        // Plataformas del escenario.
        private readonly List<Rectangle> _plataformas = new()
        {
            // Piso bajo
            new Rectangle(50, 390, 160, 14),
            new Rectangle(380, 390, 200, 14),
            new Rectangle(750, 390, 160, 14),

            // Piso medio
            new Rectangle(215, 325, 150, 14),
            new Rectangle(595, 325, 150, 14),

            // Piso alto
            PlataformaJefe
        };

        private int _nivel = 1;

        // El juego comienza en el menú.
        private string _estado = "Menu";

        private KeyboardState _tecladoAnterior;

        // 0 = JUGAR, 1 = SALIR.
        private int _opcionMenu = 0;

        private readonly Color[] _fondos =
        {
            new Color(35, 47, 75),
            new Color(39, 65, 57),
            new Color(66, 39, 67)
        };

        public Game1()
        {
            _graphics = new GraphicsDeviceManager(this);
            Content.RootDirectory = "Content";
            IsMouseVisible = true;

            _graphics.PreferredBackBufferWidth = 960;
            _graphics.PreferredBackBufferHeight = 540;

            Window.Title = "Aventura de tres niveles";
        }

        protected override void Initialize()
        {
            _jugador = new Jugador(new Vector2(100, 390));

            base.Initialize();
        }

        protected override void LoadContent()
        {
            _spriteBatch = new SpriteBatch(GraphicsDevice);

            // Textura blanca de 1x1 para dibujar formas.
            _pixel = new Texture2D(GraphicsDevice, 1, 1);
            _pixel.SetData(new[] { Color.White });

            _jugador.CargarSprite(GraphicsDevice);

            // Cargar la textura del proyectil.
            Proyectil.CargarTextura(
                GraphicsDevice,
                Path.Combine(
                    AppContext.BaseDirectory,
                    "Sprites",
                    "1 wordl",
                    "prtotagonista",
                    "disparo.png"));

            // Cargar los enemigos de las rondas.
            _rondas = new GestorRondas(
                GraphicsDevice,
                Path.Combine(
                    AppContext.BaseDirectory,
                    "Sprites",
                    "1 wordl"));

            IniciarNivelActual();
        }

        // Inicia las rondas del nivel actual.
        private void IniciarNivelActual()
        {
            _jefe = null;
            _ardilla = null;

            _rondas.IniciarNivel(_nivel);
        }

        protected override void Update(GameTime gameTime)
        {
            KeyboardState teclado = Keyboard.GetState();

            float delta = (float)gameTime.ElapsedGameTime.TotalSeconds;

            // Escape cierra el juego.
            if (teclado.IsKeyDown(Keys.Escape))
            {
                Exit();
                return;
            }

            // ---------------- MENÚ PRINCIPAL ----------------

            if (_estado == "Menu")
            {
                // Mover la selección hacia abajo.
                if (teclado.IsKeyDown(Keys.Down) &&
                    _tecladoAnterior.IsKeyUp(Keys.Down))
                {
                    _opcionMenu++;

                    if (_opcionMenu > 1)
                        _opcionMenu = 0;
                }

                // Mover la selección hacia arriba.
                if (teclado.IsKeyDown(Keys.Up) &&
                    _tecladoAnterior.IsKeyUp(Keys.Up))
                {
                    _opcionMenu--;

                    if (_opcionMenu < 0)
                        _opcionMenu = 1;
                }

                // Confirmar la opción seleccionada.
                if (teclado.IsKeyDown(Keys.Enter) &&
                    _tecladoAnterior.IsKeyUp(Keys.Enter))
                {
                    if (_opcionMenu == 0)
                    {
                        // Comenzar una partida nueva.
                        ReiniciarJuego();
                    }
                    else
                    {
                        // Cerrar el juego.
                        Exit();
                    }
                }

                _tecladoAnterior = teclado;

                base.Update(gameTime);
                return;
            }

            // ---------------- VICTORIA Y DERROTA ----------------

            if (_estado != "Jugando")
            {
                if (teclado.IsKeyDown(Keys.Enter) &&
                    _tecladoAnterior.IsKeyUp(Keys.Enter))
                {
                    if (_estado == "Perdiste")
                    {
                        ReiniciarJuego();
                    }
                    else if (_estado == "Ganaste")
                    {
                        Exit();
                    }
                }

                _tecladoAnterior = teclado;

                base.Update(gameTime);
                return;
            }

            // Actualizar al jugador.
            _jugador.Actualizar(
                teclado,
                _tecladoAnterior,
                delta,
                _plataformas);

            // Actualizar los proyectiles.
            foreach (Proyectil proyectil in _jugador.Proyectiles)
                proyectil.Actualizar(delta);

            _jugador.Proyectiles.RemoveAll(
                p => p.FueraDePantalla);

            // Actualizar enemigos y rondas.
            _rondas.Actualizar(
                delta,
                _jugador,
                _plataformas);

            // Cuando termina la ronda 4 aparece el jefe.
            if (_rondas.NivelCompletado &&
                _jefe == null &&
                _ardilla == null)
            {
                if (_nivel == 1)
                {
                    _ardilla = new JefeArdilla(
                        GraphicsDevice,
                        Path.Combine(
                            AppContext.BaseDirectory,
                            "Sprites"),
                        PlataformaJefe);
                }
                else
                {
                    _jefe = new Jefe(
                        new Vector2(760, 385),
                        8 + _nivel * 3);
                }
            }

            // Los proyectiles pueden golpear al jefe.
            if (_jefe != null && _jefe.Vivo)
            {
                foreach (Proyectil proyectil in _jugador.Proyectiles)
                {
                    if (proyectil.Activo &&
                        proyectil.Bounds.Intersects(_jefe.Bounds))
                    {
                        _jefe.RecibirGolpe();
                        proyectil.Activo = false;
                    }
                }

                _jefe.Actualizar(_jugador.Posicion, delta);

                if (_jefe.Bounds.Intersects(_jugador.Bounds))
                    _jugador.RecibirGolpe();
            }

            // Actualizar el jefe del primer nivel.
            if (_ardilla != null && _ardilla.Vivo)
            {
                _ardilla.Actualizar(
                    delta,
                    _jugador,
                    _plataformas);
            }

            _jugador.Proyectiles.RemoveAll(
                p => !p.Activo);

            // Comprobar si el jugador perdió.
            if (_jugador.Vida <= 0)
                _estado = "Perdiste";

            // Comprobar si se derrotó al jefe.
            if ((_jefe != null && !_jefe.Vivo) ||
                (_ardilla != null && !_ardilla.Vivo))
            {
                if (_nivel < 3)
                {
                    _nivel++;

                    _jugador.Curar();
                    _jugador.Posicion = new Vector2(100, 390);

                    IniciarNivelActual();
                }
                else
                {
                    _estado = "Ganaste";
                }
            }

            _tecladoAnterior = teclado;

            base.Update(gameTime);
        }

        // Reinicia la partida desde el primer nivel.
        private void ReiniciarJuego()
        {
            _nivel = 1;
            _estado = "Jugando";

            _jugador = new Jugador(new Vector2(100, 390));
            _jugador.CargarSprite(GraphicsDevice);

            IniciarNivelActual();
        }

        protected override void Draw(GameTime gameTime)
        {
            GraphicsDevice.Clear(_fondos[_nivel - 1]);

            _spriteBatch.Begin(
                samplerState: SamplerState.PointClamp);

            // ---------------- MENÚ PRINCIPAL ----------------

            if (_estado == "Menu")
            {
                // Fondo del menú.
                DibujarRectangulo(
                    new Rectangle(0, 0, 960, 540),
                    new Color(20, 29, 50));

                // Espacio para colocar el logo.
                DibujarRectangulo(
                    new Rectangle(280, 90, 400, 110),
                    new Color(38, 51, 78));

                DibujarTextoMenu(
                    "MENU",
                    424,
                    135,
                    5,
                    Color.White);

                // Opción JUGAR.
                DibujarRectangulo(
                    new Rectangle(330, 260, 300, 60),
                    _opcionMenu == 0
                        ? new Color(75, 90, 125)
                        : new Color(38, 48, 72));

                DibujarTextoMenu(
                    "JUGAR",
                    442,
                    280,
                    4,
                    _opcionMenu == 0
                        ? Color.Gold
                        : Color.White);

                // Opción SALIR.
                DibujarRectangulo(
                    new Rectangle(330, 340, 300, 60),
                    _opcionMenu == 1
                        ? new Color(75, 90, 125)
                        : new Color(38, 48, 72));

                DibujarTextoMenu(
                    "SALIR",
                    442,
                    360,
                    4,
                    _opcionMenu == 1
                        ? Color.Gold
                        : Color.White);

                _spriteBatch.End();

                base.Draw(gameTime);
                return;
            }

            // ---------------- ESCENARIO ----------------

            // Suelo.
            DibujarRectangulo(
                new Rectangle(0, 455, 960, 85),
                new Color(38, 35, 43));

            // Decoración del fondo.
            for (int i = 0; i < 9; i++)
            {
                DibujarRectangulo(
                    new Rectangle(i * 125, 430, 65, 25),
                    new Color(52, 54, 65));
            }

            // Dibujar plataformas.
            foreach (Rectangle p in _plataformas)
            {
                DibujarRectangulo(
                    p,
                    new Color(88, 78, 112));

                DibujarRectangulo(
                    new Rectangle(p.X, p.Y, p.Width, 4),
                    new Color(150, 140, 185));
            }

            // Dibujar al jugador.
            _jugador.Dibujar(_spriteBatch, _pixel);

            // Dibujar las rondas y enemigos.
            _rondas.Dibujar(_spriteBatch, _pixel);

            // Dibujar proyectiles.
            foreach (Proyectil proyectil in _jugador.Proyectiles)
            {
                proyectil.Dibujar(_spriteBatch, _pixel);
            }

            // Dibujar jefes.
            if (_jefe != null && _jefe.Vivo)
                _jefe.Dibujar(_spriteBatch, _pixel);

            if (_ardilla != null && _ardilla.Vivo)
                _ardilla.Dibujar(_spriteBatch, _pixel);

            // ---------------- BARRA DE VIDA ----------------

            DibujarRectangulo(
                new Rectangle(20, 20, 160, 18),
                Color.DarkRed);

            DibujarRectangulo(
                new Rectangle(
                    20,
                    20,
                    Math.Max(0, _jugador.Vida * 16),
                    18),
                Color.LimeGreen);

            // ---------------- PROGRESO DE RONDAS ----------------

            for (int i = 0; i < GestorRondas.RondasPorNivel; i++)
            {
                bool hecha =
                    i < _rondas.RondaActual - 1 ||
                    _rondas.NivelCompletado;

                bool actual =
                    i == _rondas.RondaActual - 1 &&
                    !_rondas.NivelCompletado;

                DibujarRectangulo(
                    new Rectangle(20 + i * 22, 48, 18, 8),
                    hecha
                        ? Color.Gold
                        : actual
                            ? Color.Orange
                            : Color.Black);
            }

            // ---------------- RECARGA DEL DASH ----------------

            DibujarRectangulo(
                new Rectangle(20, 64, 88, 6),
                Color.Black);

            DibujarRectangulo(
                new Rectangle(
                    20,
                    64,
                    (int)(88 * _jugador.DashProgreso),
                    6),
                _jugador.DashProgreso >= 1f
                    ? Color.Cyan
                    : Color.SteelBlue);

            // ---------------- MENSAJE DE DERROTA ----------------

            if (_estado == "Perdiste")
            {
                DibujarRectangulo(
                    new Rectangle(260, 190, 440, 120),
                    Color.DarkRed);

                DibujarRectangulo(
                    new Rectangle(290, 220, 380, 12),
                    Color.White);

                DibujarRectangulo(
                    new Rectangle(330, 255, 300, 12),
                    Color.Orange);
            }

            // ---------------- MENSAJE DE VICTORIA ----------------

            else if (_estado == "Ganaste")
            {
                DibujarRectangulo(
                    new Rectangle(260, 190, 440, 120),
                    Color.DarkGreen);

                DibujarRectangulo(
                    new Rectangle(300, 220, 360, 12),
                    Color.Gold);

                DibujarRectangulo(
                    new Rectangle(340, 255, 280, 12),
                    Color.White);
            }

            _spriteBatch.End();

            base.Draw(gameTime);
        }

        // Dibuja un rectángulo en pantalla.
        private void DibujarRectangulo(
            Rectangle rectangulo,
            Color color)
        {
            _spriteBatch.Draw(
                _pixel,
                rectangulo,
                color);
        }

        // Dibuja las letras del menú.
        private void DibujarTextoMenu(
            string texto,
            int x,
            int y,
            int escala,
            Color color)
        {
            foreach (char letra in texto)
            {
                int[] patron = ObtenerPatron(letra);

                for (int fila = 0; fila < 5; fila++)
                {
                    for (int columna = 0; columna < 3; columna++)
                    {
                        if ((patron[fila] &
                            (1 << (2 - columna))) != 0)
                        {
                            DibujarRectangulo(
                                new Rectangle(
                                    x + columna * escala,
                                    y + fila * escala,
                                    escala,
                                    escala),
                                color);
                        }
                    }
                }

                x += escala * 4;
            }
        }

        // Patrones de las letras que utiliza el menú.
        private int[] ObtenerPatron(char letra)
        {
            switch (letra)
            {
                case 'M':
                    return new[] { 5, 7, 7, 5, 5 };

                case 'E':
                    return new[] { 7, 4, 6, 4, 7 };

                case 'N':
                    return new[] { 5, 7, 7, 7, 5 };

                case 'U':
                    return new[] { 5, 5, 5, 5, 7 };

                case 'J':
                    return new[] { 1, 1, 1, 5, 2 };

                case 'G':
                    return new[] { 3, 4, 5, 5, 3 };

                case 'A':
                    return new[] { 2, 5, 7, 5, 5 };

                case 'R':
                    return new[] { 6, 5, 6, 5, 5 };

                case 'S':
                    return new[] { 3, 4, 2, 1, 6 };

                case 'L':
                    return new[] { 4, 4, 4, 4, 7 };

                case 'I':
                    return new[] { 7, 2, 2, 2, 7 };

                default:
                    return new[] { 0, 0, 0, 0, 0 };
            }
        }
    }
}
